# ===== LLM Provider Configuration =====

# Choose LLM provider (default: anthropic)
# - anthropic: Claude models
# - openai: GPT models
# - deepseek: DeepSeek Native (api.deepseek.com)
# - deepseek_gateway: DeepSeek via Gateway (volceapi.com)
LLM_PROVIDER=anthropic

# API keys (configure the one matching your LLM_PROVIDER)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_GATEWAY_API_KEY=your_deepseek_gateway_api_key_here

# Required: Tavily API key for web search (https://tavily.com - free tier available)
TAVILY_API_KEY=your_tavily_api_key_here

# ===== User Management & Authentication =====

# Required for production: PostgreSQL connection string
# If not set, SQLite will be used for development (threads.db)
# Use docker-compose up -d postgres to start PostgreSQL
DATABASE_URL=postgresql://sunnyagent:sunnyagent123@localhost:5432/sunnyagent

# Default admin credentials (used on first startup when no users exist)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your_secure_password_here

# JWT Configuration
# JWT_SECRET_KEY=your_jwt_secret_key_here  # If not set, a random key will be generated
# JWT_EXPIRATION=86400  # Token expiration in seconds (default: 24 hours)

# ===== Langfuse Observability =====

# Enable/disable Langfuse tracing (set to false to completely disable)
LANGFUSE_TRACING_ENABLED=true

# Langfuse service URL (for tracing and Admin UI link)
LANGFUSE_BASE_URL=http://localhost:3001

# Langfuse project API keys (get from Langfuse project settings)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here

# Langfuse organization API keys (for Admin API - user sync)
LANGFUSE_ORG_PUBLIC_KEY=pk-org-your_org_public_key_here
LANGFUSE_ORG_SECRET_KEY=sk-org-your_org_secret_key_here

# Optional: Trace sampling rate (0.0 to 1.0, default: 1.0 = 100%)
# LANGFUSE_SAMPLE_RATE=1.0

# Optional: OTEL Host for LiteLLM integration (defaults to LANGFUSE_BASE_URL)
# This enables automatic token usage and model name tracking for all LLM calls
# LANGFUSE_OTEL_HOST=http://localhost:3001

# Langfuse Docker deployment (used in docker-compose.yml)
# LANGFUSE_DATABASE_URL=postgresql://sunnyagent:sunnyagent123@postgres:5432/langfuse
# LANGFUSE_NEXTAUTH_SECRET=your_256_bit_secret_here
# LANGFUSE_SALT=your_256_bit_salt_here
# LANGFUSE_ENCRYPTION_KEY=your_32_byte_hex_key_here
